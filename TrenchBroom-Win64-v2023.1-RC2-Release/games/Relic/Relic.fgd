// Relic FGD for TrenchBroom - Z-Up, 1 unit = 1 inch
// Standalone: no includes, no external FGD requirements.
// Syntax follows TrenchBroom FGD grammar: size(min, max) uses a comma,
// model() uses an EL dictionary with a concrete path.

@PointClass color(0 255 0) size(-53 -47 -29, 46 38 48) model({ "path": "Models/player.mdl" }) = player_start : "Player Spawn" [
    angle(integer) : "Yaw" : 0 : "Yaw angle"
    targetname(string) : "Name"
]

@PointClass color(255 0 0) size(-35 -38 -27, 33 34 37) model({ "path": "Models/soldier.mdl" }) = enemy_soldier : "Enemy Soldier" [
    angle(integer) : "Yaw" : 0
    health(integer) : "Health" : 100
    weapon(string) : "Weapon" : "rifle"
    targetname(string) : "Name"
    model(string) : "Model" : "soldier.mdl"
]

@PointClass color(180 0 0) size(-41 -38 -27, 41 32 30) model({ "path": "Models/dog.mdl" }) = enemy_dog : "Enemy Dog" [
    angle(integer) : "Yaw" : 0
    health(integer) : "Health" : 50
    targetname(string) : "Name"
    model(string) : "Model" : "dog.mdl"
]

@PointClass color(200 0 200) size(-52 -52 -27, 67 46 78) model({ "path": "Models/demon.mdl" }) = enemy_demon : "Enemy Demon" [
    angle(integer) : "Yaw" : 0
    health(integer) : "Health" : 300
    targetname(string) : "Name"
    model(string) : "Model" : "demon.mdl"
]

@PointClass color(0 255 255) size(-16 -16 0, 16 16 16) = weapon_pickup : "Weapon Pickup" [
    weapon(string) : "Weapon" : "Rifle" : "WeaponDefinition name"
    targetname(string) : "Name"
]

@PointClass color(0 255 0) size(-16 -16 0, 16 16 16) = health_pickup : "Health Pickup" [
    heal(integer) : "Heal Amount" : 25
    targetname(string) : "Name"
]

@PointClass color(255 255 0) size(-16 -16 0, 16 16 32) model({ "path": "Models/crate.obj" }) = prop_static : "Static Prop" [
    model(string) : "Model" : "crate.obj" : "Path relative to Assets/Models"
    targetname(string) : "Name"
    angle(integer) : "Yaw" : 0
]

@PointClass color(255 255 150) size(-8 -8 -8, 8 8 8) = light : "Point Light" [
    intensity(integer) : "Intensity" : 800
    radius(integer) : "Range" : 512
    color(color255) : "Color" : "255 220 180"
    light(integer) : "Legacy Brightness" : 300
    targetname(string) : "Name"
    castShadows(choices) : "Cast Shadows" : 0 = [ 0 : "No" 1 : "Yes" ]
]

@PointClass color(255 200 100) size(-8 -8 -8, 8 8 8) = light_spot : "Spot Light" [
    intensity(integer) : "Intensity" : 1200
    radius(integer) : "Range" : 1024
    color(color255) : "Color" : "255 220 180"
    angles(string) : "Angles" : "-45 0 0"
    targetname(string) : "Name"
    castShadows(choices) : "Cast Shadows" : 0 = [ 0 : "No" 1 : "Yes" ]
]

@PointClass color(255 255 50) size(-8 -8 -8, 8 8 8) = light_sun : "Directional Sun" [
    intensity(float) : "Intensity" : "2.5"
    angles(string) : "Angles" : "-45 45 0"
    color(color255) : "Color" : "255 255 255"
    targetname(string) : "Name"
]

@PointClass color(100 150 200) size(-16 -16 -16, 16 16 16) = env_fog : "Fog" [
    color(color255) : "Color" : "120 140 180"
    density(float) : "Density" : "0.002"
    targetname(string) : "Name"
]

@PointClass color(150 100 200) size(-16 -16 -16, 16 16 16) = env_postprocess : "Post Process" [
    bloom(choices) : "Bloom" : 1 = [ 0 : "Off" 1 : "On" ]
    exposure(float) : "Exposure" : "1.1"
    bloom_intensity(float) : "Bloom Intensity" : "1.0"
    bloom_threshold(float) : "Bloom Threshold" : "1.0"
    tonemap(choices) : "Tone Map" : "ACES" = [ "Reinhard" : "Reinhard" "ACES" : "ACES" ]
    targetname(string) : "Name"
]

@SolidClass color(255 0 255) = trigger_once : "Trigger Once" [
    target(string) : "Target"
    targetname(string) : "Name"
]

@SolidClass color(64 64 64) = worldspawn : "World Spawn" [
]

